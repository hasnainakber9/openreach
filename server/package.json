{
  "name": "@openreach/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:pg": "node -e \"if (!/^postgres(ql)?:/.test(process.env.TEST_DATABASE_URL || '')) { console.error('Set TEST_DATABASE_URL=postgres://user:pass@host:5432/db (a database the tests may create schemas in).'); process.exit(1); }\" && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "imapflow": "^2.10.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "stripe": "^23.1.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "playwright": "1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
